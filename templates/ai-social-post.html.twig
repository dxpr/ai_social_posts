{#
/**
 * @file
 * Default theme implementation to display an AI Social Post entity.
 *
 * Available variables:
 * - content: All AI Social Post items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the container element.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - created: The creation date of the post.
 *
 * @see template_preprocess_ai_social_post()
 *
 * @ingroup themeable
 */
#}
<article{{ attributes.addClass('ai-social-post') }}>
  <div class="content">
    {{ content|without('created') }}
  </div>
  
  {% if content.created %}
    <div class="details-wrapper">
      <div class="details-description">
        <small class="text-muted">{{ 'Posted on'|t }}: {{ content.created }}</small>
      </div>
    </div>
  {% endif %}
</article> 
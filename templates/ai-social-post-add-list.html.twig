{#
/**
 * @file
 * Default theme implementation to display a list of AI Social Post types.
 *
 * Available variables:
 * - content: An array of AI Social Post types, each containing:
 *   - url: The URL to create a new post of this type.
 *   - title: The label of the post type.
 *   - type_id: The machine name of the post type.
 */
#}
<div class="panel gin-layer-wrapper">
  <div class="node-type-list admin-list panel__content">
    {% if content %}
      {% for type_id, item in content %}
        <div class="admin-item">
          <a href="{{ item.url }}" title="{{ item.title }}" class="admin-item__link"></a>
          <div class="admin-item__title">
            {{ item.title }}
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>
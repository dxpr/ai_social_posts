{#
/**
 * @file
 * Default theme implementation to display a list of AI Social Post types.
 *
 * Available variables:
 * - content: An array of AI Social Post types, each containing:
 *   - link: The link to create a new post of this type.
 *   - description: A description of the post type.
 */
#}
<div class="ai-social-post-add-list">
  {% if content %}
    <dl>
      {% for type, item in content %}
        <dt>{{ item.link }}</dt>
        <dd>{{ item.description }}</dd>
      {% endfor %}
    </dl>
  {% endif %}
</div> 
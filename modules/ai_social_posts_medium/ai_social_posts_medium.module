<?php

/**
 * @file
 * Primary module hooks for AI Social Posts MEDIUM module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ai_social_posts_medium\Hook\AiSocialPostsMediumHooks;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function ai_social_posts_medium_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(AiSocialPostsMediumHooks::class)->formAlter($form, $form_state, $form_id);
}

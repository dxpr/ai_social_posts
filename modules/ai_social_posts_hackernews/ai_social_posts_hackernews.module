<?php

/**
 * @file
 * Primary module hooks for AI Social Posts Hacker News module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\ai_social_posts_hackernews\Hook\AiSocialPostsHackernewsHooks;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function ai_social_posts_hackernews_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(AiSocialPostsHackernewsHooks::class)->formAlter($form, $form_state, $form_id);
}
